# NPM Configuration for Blueprintify
# Improves developer experience with sensible defaults

# NOTE: engine-strict intentionally set to false.
# The project targets node 20 (.nvmrc) but some dependencies
# (e.g. @cloudflare/kv-asset-handler) require node >=22.
engine-strict=false

# Save exact versions (no ^ or ~)
save-exact=true

# Default to production=false for dev dependencies

# Use the lockfile for reproducible installs
package-lock=true

# Maximum time to wait for network requests (30 seconds)
fetch-timeout=30000

# Maximum number of retries for network requests
fetch-retries=3

# Retry delay in milliseconds
fetch-retry-mintimeout=10000
fetch-retry-maxtimeout=60000

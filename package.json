{
  "name": "blueprint-generator",
  "version": "1.0.0",
  "private": true,
  "engines": {
    "node": ">=22"
  },
  "type": "module",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "postinstall": "npm run build --workspace=@blueprint/shared",
    "prepare": "husky",
    "dev": "npm run dev --workspace=apps/web",
    "dev:api": "npm run dev --workspace=apps/api",
    "dev:all": "concurrently \"npm run dev:api\" \"npm run dev\"",
    "build": "npm run build --workspace=@blueprint/shared && npm run build --workspace=apps/web",
    "build:api": "npm run build --workspace=apps/api",
    "lint": "eslint . --ext .ts,.tsx",
    "lint:fix": "eslint . --ext .ts,.tsx --fix",
    "test": "npm run test --workspace=apps/web",
    "test:api": "npm run test --workspace=apps/api",
    "test:all": "npm run test --workspace=apps/web -- --run && npm run test --workspace=apps/api && npm run test --workspace=packages/shared",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "scan:secrets": "node scripts/scan-secrets.mjs",
    "check": "npm run typecheck && npm run lint && npm run scan:secrets && npm run audit && npm run test:all",
    "db:migrate": "node scripts/migrate.ts",
    "db:init": "node scripts/migrate.ts init",
    "db:status": "node scripts/migrate.ts status",
    "db:rollback": "node scripts/migrate.ts rollback",
    "brocula": "node scripts/brocula-hunt.mjs",
    "normalize:issues": "node scripts/normalize-issue-labels.mjs",
    "validate:wrangler": "node scripts/validate-wrangler.mjs",
    "validate:all": "npm run validate:wrangler && npm run scan:secrets && npm run audit",
    "predeploy:api": "npm run validate:wrangler",
    "audit": "npm audit --audit-level=high",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "doctor": "node -e \"console.log('Node:', process.version); const fs=require('fs'); try{console.log('.nvmrc:',fs.readFileSync('.nvmrc','utf8').trim())}catch(e){}\"",
    "clean": "npm run clean --workspaces --if-present",
    "clean:dist": "rm -rf apps/*/dist packages/*/dist",
    "reset": "npm run clean && rm -rf node_modules apps/*/node_modules packages/*/node_modules",
    "test:coverage": "npm run test:coverage --workspace=apps/web -- --run && npm run test --workspace=apps/api && npm run test --workspace=packages/shared",
    "preview": "npm run build && npm run dev:all"
  },
  "devDependencies": {
    "@emnapi/core": "1.11.3",
    "@eslint/js": "9.39.5",
    "@img/sharp-wasm32": "0.35.3",
    "@playwright/test": "1.62.1",
    "@types/jest-axe": "3.5.9",
    "@types/node": "26.1.2",
    "chrome-launcher": "1.2.1",
    "concurrently": "10.0.4",
    "eslint": "9.39.5",
    "eslint-plugin-jsx-a11y": "6.10.2",
    "eslint-plugin-react": "7.37.5",
    "eslint-plugin-react-hooks": "7.1.1",
    "husky": "9.1.7",
    "jest-axe": "11.0.0",
    "lighthouse": "13.4.1",
    "lint-staged": "17.3.0",
    "playwright": "1.62.1",
    "prettier": "3.9.6",
    "typescript": "6.0.3",
    "typescript-eslint": "8.65.0"
  },
  "overrides": {
    "brace-expansion": "5.0.9",
    "shell-quote": "1.10.0",
    "undici": "7.29.0",
    "ws": "8.21.0",
    "sharp": "0.35.3",
    "miniflare": {
      "sharp": "0.35.3"
    }
  },
  "lint-staged": {
    "*.{ts,tsx}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{json,md,yml,yaml}": [
      "prettier --write"
    ]
  }
}

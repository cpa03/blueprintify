# Frontend Environment Variables
# Copy this file to .env and fill in your actual values

# Optional: API base URL (defaults to /api)
# VITE_API_BASE_URL=/api

# Optional: API key for protected endpoints.
# PUBLIC BY CONSTRUCTION — VITE_* values are inlined into the browser bundle at
# build time, so anything set here is readable by every visitor and cannot be
# kept secret. Leave unset unless you need it locally; unset means the client
# sends no x-api-key header and the API answers 401 (or 503 while the Worker
# API_KEY secret is also unset). See docs/environment-variables.md.
# VITE_API_KEY=

# Optional: External URLs
# VITE_PROJECT_HOMEPAGE_URL=https://blueprint-generator.pages.dev
# VITE_GITHUB_URL=https://github.com/cpa03/blueprintify

# Optional: Storage quota in MB (defaults to 5)
# VITE_STORAGE_QUOTA_MB=5

# Optional: App name (defaults to Blueprintify)
# VITE_APP_NAME=Blueprintify

# Optional: Default project name (defaults to my-project)
# VITE_DEFAULT_PROJECT_NAME=my-project

# Optional: Enable analytics
# VITE_ENABLE_ANALYTICS=false

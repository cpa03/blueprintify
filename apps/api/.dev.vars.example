# Cloudflare Workers Environment Variables
# Copy this file to .dev.vars and fill in your actual values
# DO NOT commit .dev.vars to version control
#
# Flexy says: Default values below are documented for clarity.
# The SINGLE SOURCE OF TRUTH for defaults lives in:
#   packages/shared/src/config.ts (AI_DEFAULTS, DEV_DEFAULTS, RATE_LIMIT_DEFAULTS, etc.)
# apps/api/src/config/env.ts loads env vars and falls back to shared config defaults.
# You only NEED to set OPENAI_API_KEY. All other vars are optional overrides.

# Required: Your OpenAI API key
OPENAI_API_KEY=your_openai_api_key_here

# AI Service Configuration (defaults from @blueprint/shared AI_DEFAULTS)
# OPENAI_BASE_URL=https://api.openai.com/v1
# OPENAI_MODEL=gpt-4o-mini
# OPENAI_TIMEOUT_MS=60000
# OPENAI_MAX_TOKENS=4000
# OPENAI_TEMPERATURE=0.7

# API Configuration (defaults from @blueprint/shared SHARED_DEFAULTS)
# API_VERSION=1.0.0
# CORS_ORIGIN=http://localhost:3000
# CORS_MAX_AGE=86400

# Rate Limiting (defaults from @blueprint/shared RATE_LIMIT_DEFAULTS)
# RATE_LIMIT_WINDOW_MS=60000
# RATE_LIMIT_STRICT_MAX=10
# RATE_LIMIT_STANDARD_MAX=60
# RATE_LIMIT_LENIENT_MAX=120

# Storage Configuration (defaults from @blueprint/shared SHARED_DEFAULTS)
# STORAGE_QUOTA_MB=5

# Circuit Breaker (defaults from @blueprint/shared CIRCUIT_BREAKER_DEFAULTS)
# CIRCUIT_BREAKER_FAILURE_THRESHOLD=5
# CIRCUIT_BREAKER_RESET_TIMEOUT_MS=60000
# CIRCUIT_BREAKER_HALF_OPEN_MAX_CALLS=3

# Retry Configuration (defaults from @blueprint/shared RETRY_CONFIG)
# RETRY_MAX_RETRIES=3
# RETRY_INITIAL_DELAY_MS=1000
# RETRY_BACKOFF_FACTOR=2
# RETRY_MAX_DELAY_MS=10000

# External URLs (defaults from @blueprint/shared DEFAULT_URLS)
# PROJECT_HOMEPAGE_URL=https://blueprint-generator.pages.dev
# GITHUB_URL=https://github.com

# Security
# API_KEY=your_api_key_here

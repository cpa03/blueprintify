{
  "name": "@blueprint/api",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "prebuild": "node -e \"const v=process.version.match(/v(\\d+)/)[1];if(+v<22){console.error('Error: Node.js >=22 required (found '+process.version+'). Use nvm install 22 && nvm use 22');process.exit(1)}\"",
    "build": "wrangler deploy --dry-run --outdir=dist --env=\"\"",
    "deploy": "node ../../scripts/validate-wrangler.mjs && wrangler deploy",
    "test": "vitest",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src --ext .ts",
    "lint:fix": "eslint src --ext .ts --fix",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "@blueprint/shared": "1.0.0",
    "hono": "4.12.27",
    "openai": "6.45.0",
    "zod": "^3.22.4"
  },
  "devDependencies": {
    "@cloudflare/vitest-pool-workers": "0.18.0",
    "@cloudflare/workers-types": "5.20260706.1",
    "vitest": "^4.1.10",
    "wrangler": "4.107.0"
  }
}
